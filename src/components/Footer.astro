---
import Logo from './Logo.astro';
import Stickers from './Stickers.astro';
import { CATEGORIES, MERCHANTS, SITE } from '../lib/site';
---
<Stickers only="inline" />
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <Logo size={30} class="footer-logo" />
      <p class="footer-tagline">{SITE.tagline}. Mobilă, grădină, scule, securitate, electrice, birou și etichete — selectate din {MERCHANTS.length} magazine românești.</p>
      <p class="footer-aff">
        Site afiliat: produsele sunt vândute și livrate de magazinele partenere, prin rețeaua
        <a href="https://2performant.com" target="_blank" rel="nofollow noopener">2Performant</a>.
        Dacă cumperi prin linkurile noastre, primim un mic comision, fără cost suplimentar pentru tine.
      </p>
    </div>

    <nav class="footer-nav" aria-label="Categorii">
      <h3>Categorii</h3>
      <ul>
        {CATEGORIES.map(c => <li><a href={`/${c.slug}`}>{c.name}</a></li>)}
        <li><a href="/promotii">Promoții</a></li>
      </ul>
    </nav>

    <nav class="footer-nav" aria-label="Informații">
      <h3>Informații</h3>
      <ul>
        <li><a href="/blog">Blog și ghiduri</a></li>
        <li><a href="/confidentialitate">Confidențialitate</a></li>
        <li><a href="/cookies">Politica cookies</a></li>
        <li><a href="/gdpr">GDPR</a></li>
        <li><a href="mailto:office@gherasimmarius.com">Contact</a></li>
      </ul>
      <h3 class="footer-h-merchants">Magazine partenere</h3>
      <p class="footer-merchants">{MERCHANTS.join(' · ')}</p>
    </nav>

    <div class="footer-newsletter">
      <h3>Nu rata ofertele</h3>
      <p>Reduceri selectate pe categorii, o dată pe săptămână. Fără spam.</p>
      <div class="ml-embedded" data-form="197939874705180024"></div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>
      © {new Date().getFullYear()} {SITE.name} · Gherasim Marius PFA · CUI 50080715 ·
      <a href="/confidentialitate">Confidențialitate</a> ·
      <a href="https://anpc.ro" target="_blank" rel="noopener">ANPC</a> ·
      <a href="https://reclamatiisal.anpc.ro" target="_blank" rel="noopener">SAL</a>
    </p>
  </div>
</footer>

<script is:inline>
  // MailerLite se încarcă după afișarea paginii (3 s) sau când vizitatorul ajunge la formular — nu mai încetinește prima afișare
  (function (w, d) {
    w.ml = w.ml || function () { (w.ml.q = w.ml.q || []).push(arguments); };
    ml('account', '1999265');
    var done = false;
    function loadML() {
      if (done) return; done = true;
      var s = d.createElement('script'); s.async = true;
      s.src = 'https://assets.mailerlite.com/js/universal.js';
      d.head.appendChild(s);
    }
    var form = d.querySelector('.ml-embedded');
    if (form && 'IntersectionObserver' in w) {
      new IntersectionObserver(function (en, o) { if (en[0].isIntersecting) { o.disconnect(); loadML(); } }, { rootMargin: '400px' }).observe(form);
    }
    w.addEventListener('load', function () { setTimeout(loadML, 3000); });
  })(window, document);
</script>
