---
import Logo from './Logo.astro';
import Stickers from './Stickers.astro';
import { CATEGORIES, countSub, PRODUCTS, MERCHANTS, fmtInt } from '../lib/site';
const currentPath = Astro.url.pathname;
const total = PRODUCTS.length;
---
<div class="top-bar">
  <div class="top-bar-inner">
    <span class="top-bar-left"><strong>{fmtInt(total)}</strong> produse · <strong>{MERCHANTS.length}</strong> magazine românești<span class="tb-extra"> · prețuri actualizate din feed</span></span>
    <span class="top-bar-right">Site afiliat <a href="https://2performant.com" target="_blank" rel="nofollow noopener">2Performant</a> · <a href="/promotii">Promoții</a> · <a href="/blog">Ghiduri</a></span>
  </div>
</div>

<header class="site-header">
  <div class="header-inner">
    <button class="nav-toggle" id="nav-toggle" aria-label="Deschide meniul" aria-expanded="false" aria-controls="mobile-drawer">
      <span></span><span></span><span></span>
    </button>
    <Logo />

    <div class="header-search" id="header-search">
      <form action="/cautare" method="get" role="search" class="search-form">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2.2"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        <input type="search" name="q" id="search-input" placeholder="Caută: drujbă, canapea, cameră IP, etichete…" autocomplete="off" aria-label="Caută produse" />
        <button type="submit" class="search-submit">Caută</button>
      </form>
      <div id="search-panel" class="search-panel" hidden></div>
    </div>

    <a href="/promotii" class="header-deals">
      <span class="header-deals-ico" aria-hidden="true">%</span>
      <span>Promoții</span>
    </a>
  </div>

  <nav class="cat-bar" aria-label="Categorii">
    <ul class="cat-bar-list">
      {CATEGORIES.map(c => {
        const subs = c.subs.filter(s => !s.hidden);
        const half = Math.ceil(subs.length / 2);
        return (
          <li class="cat-bar-item" style={`--acc:${c.accent}`}>
            <a href={`/${c.slug}`} class={currentPath.startsWith(`/${c.slug}`) ? 'active' : ''}>
              <span aria-hidden="true">{c.icon}</span> {c.short}
            </a>
            <div class="mega">
              <div class="mega-head">
                <a href={`/${c.slug}`} class="mega-title">{c.icon} {c.name} <span>→</span></a>
                <p>{c.desc}</p>
              </div>
              <div class={`mega-cols ${subs.length > 7 ? 'two' : ''}`}>
                {[subs.slice(0, subs.length > 7 ? half : subs.length), subs.length > 7 ? subs.slice(half) : []].map(col => col.length > 0 && (
                  <ul>
                    {col.map(s => (
                      <li><a href={`/${c.slug}/${s.slug}`}>{s.name} <em>{fmtInt(countSub(c.slug, s.slug))}</em></a></li>
                    ))}
                  </ul>
                ))}
              </div>
            </div>
          </li>
        );
      })}
      <li class="cat-bar-item cat-bar-blog"><a href="/blog" class={currentPath.startsWith('/blog') ? 'active' : ''}>📝 Blog</a></li>
    </ul>
  </nav>
  <Stickers only="top" />
</header>

<!-- Meniu mobil -->
<div class="drawer-backdrop" id="drawer-backdrop" hidden></div>
<aside class="mobile-drawer" id="mobile-drawer" aria-label="Meniu" hidden>
  <div class="drawer-head">
    <Logo size={30} />
    <button class="drawer-close" id="drawer-close" aria-label="Închide meniul">✕</button>
  </div>
  <a href="/promotii" class="drawer-deals">🔥 Promoții și reduceri</a>
  {CATEGORIES.map(c => (
    <details class="drawer-cat" style={`--acc:${c.accent}`}>
      <summary><span aria-hidden="true">{c.icon}</span> {c.name}</summary>
      <ul>
        <li><a href={`/${c.slug}`}><strong>Toate din {c.short}</strong></a></li>
        {c.subs.map(s => <li><a href={`/${c.slug}/${s.slug}`}>{s.name}</a></li>)}
      </ul>
    </details>
  ))}
  <a href="/blog" class="drawer-link">📝 Blog și ghiduri</a>
</aside>
