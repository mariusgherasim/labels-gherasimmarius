---
const currentPath = Astro.url.pathname;
---
<div class="top-bar">
  <div class="top-bar-inner">
    <span class="top-bar-left">Consultanță tehnică · Livrare rapidă din stoc · 20+ ani experiență</span>
    <div class="top-bar-right">
      <span>Site afiliat <a href="https://www.labelshop.ro" target="_blank" rel="nofollow noopener">labelshop.ro</a></span>
      <span>via <a href="https://2performant.com" target="_blank" rel="nofollow noopener">2Performant</a></span>
    </div>
  </div>
</div>

<header class="site-header">
  <div class="header-inner" id="header-inner">
    <a href="/" class="logo" aria-label="LabelShop — acasă">
      <svg width="34" height="34" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect width="36" height="36" rx="8" fill="#E63329"/>
        <path d="M7 9h13l8 8-8 8H7l8-8-8-8z" fill="white"/>
      </svg>
      <span class="logo-text">Label<strong>Shop</strong></span>
    </a>

    <nav class="main-nav" aria-label="Navigare principală">
      <ul>

        <!-- ETICHETE -->
        <li class="nav-item">
          <a href="/etichete" class={currentPath.startsWith('/etichete') ? 'active' : ''}>
            Etichete <span class="arrow">▾</span>
          </a>
          <div class="dropdown">
            <a href="/etichete">Etichete în rolă</a>
            <a href="/etichete">Etichete în coală (A4)</a>
            <a href="/etichete">Etichete de preț</a>
            <a href="/etichete">Etichete inkjet</a>
            <a href="/etichete">Etichete personalizate</a>
            <span class="dropdown-heading">Categorii speciale</span>
            <a href="/etichete" class="dropdown-sub">Etichete ocazii și sărbători</a>
            <a href="/etichete" class="dropdown-sub">Etichete "Handmade"</a>
            <a href="/etichete" class="dropdown-sub">Etichete HACCP alimente</a>
            <a href="/etichete" class="dropdown-sub">Etichete promoționale</a>
            <a href="/etichete" class="dropdown-sub">Etichete logistică</a>
            <a href="/etichete" class="dropdown-sub">Etichete "Fabricat în"</a>
            <a href="/etichete" class="dropdown-sub">Etichete sticle</a>
            <a href="/etichete" class="dropdown-sub">Etichete borcane</a>
          </div>
        </li>

        <!-- CONSUMABILE -->
        <li class="nav-item">
          <a href="/consumabile" class={currentPath.startsWith('/consumabile') ? 'active' : ''}>
            Consumabile <span class="arrow">▾</span>
          </a>
          <div class="dropdown">
            <a href="/consumabile">Riboane</a>
            <a href="/consumabile" class="dropdown-sub">Riboane ceară</a>
            <a href="/consumabile" class="dropdown-sub">Riboane ceară și rășină</a>
            <a href="/consumabile" class="dropdown-sub">Riboane rășină</a>
            <span class="dropdown-heading">Alte consumabile</span>
            <a href="/consumabile">Hârtie A4, Hârtie copiator</a>
            <a href="/consumabile">Cartușe și tonere</a>
            <a href="/consumabile">Capete de imprimare</a>
            <a href="/consumabile">Consumabile Brother</a>
          </div>
        </li>

        <!-- ECHIPAMENTE -->
        <li class="nav-item">
          <a href="/echipamente" class={currentPath.startsWith('/echipamente') ? 'active' : ''}>
            Echipamente <span class="arrow">▾</span>
          </a>
          <div class="dropdown">
            <a href="/echipamente">Imprimante termice etichete</a>
            <a href="/echipamente" class="dropdown-sub">Transfer Termic — Volum mic</a>
            <a href="/echipamente" class="dropdown-sub">Transfer Termic — Volum mediu</a>
            <a href="/echipamente" class="dropdown-sub">Transfer Termic — Volum mare</a>
            <span class="dropdown-heading">Alte echipamente</span>
            <a href="/echipamente">Imprimante etichete inkjet color</a>
            <a href="/echipamente">Imprimante portabile</a>
            <a href="/echipamente">Accesorii imprimante</a>
            <a href="/echipamente">Inscripționare și marcare</a>
            <a href="/echipamente">Aplicatoare și marcatoare</a>
            <a href="/echipamente">Dispensere și roluitori</a>
            <a href="/echipamente">Cititoare coduri de bare</a>
          </div>
        </li>

        <!-- AMBALARE -->
        <li class="nav-item">
          <a href="/ambalare" class={currentPath.startsWith('/ambalare') ? 'active' : ''}>
            Ambalare & Coletare <span class="arrow">▾</span>
          </a>
          <div class="dropdown dropdown-wide">
            <div class="dropdown-wide-col">
              <a href="/ambalare">Ambalaje personalizate</a>
              <a href="/ambalare" class="dropdown-sub">Pungi personalizate</a>
              <a href="/ambalare">Bandă adezivă</a>
              <a href="/ambalare">Bandă umectibilă</a>
              <a href="/ambalare">Cutii de carton</a>
              <a href="/ambalare" class="dropdown-sub">Cutii clasice</a>
              <a href="/ambalare" class="dropdown-sub">Cutii cu autoformare</a>
              <a href="/ambalare" class="dropdown-sub">Cutii pentru pizza</a>
              <a href="/ambalare" class="dropdown-sub">Cutii e-commerce</a>
              <a href="/ambalare">Folie stretch și folie cu bule</a>
              <a href="/ambalare">Eco / Reciclabile</a>
              <a href="/ambalare">Plasă protecție</a>
            </div>
            <div class="dropdown-wide-col">
              <a href="/ambalare">Plicuri</a>
              <a href="/ambalare" class="dropdown-sub">Plicuri curierat AWB</a>
              <a href="/ambalare" class="dropdown-sub">Plicuri de carton</a>
              <a href="/ambalare" class="dropdown-sub">Plicuri cu bule</a>
              <a href="/ambalare" class="dropdown-sub">Plicuri ecommerce</a>
              <a href="/ambalare">Pungi și sacoșe</a>
              <a href="/ambalare" class="dropdown-sub">Pungi curierat</a>
              <a href="/ambalare" class="dropdown-sub">Pungi coloane de aer</a>
              <a href="/ambalare" class="dropdown-sub">Pungi hârtie</a>
              <a href="/ambalare" class="dropdown-sub">Pungi ziplock cu fermoar</a>
              <a href="/ambalare">Tuburi de carton</a>
              <a href="/ambalare">Separatoare carton și colțare</a>
            </div>
          </div>
        </li>

        <li class="nav-item"><a href="https://www.labelshop.ro/promotii" target="_blank" rel="nofollow noopener" style="color:var(--red);font-weight:800;">Promoții</a></li>
        <li class="nav-item"><a href="https://www.labelshop.ro/blog" target="_blank" rel="nofollow noopener">Blog</a></li>
      </ul>
    </nav>

    <div class="header-search">
      <input type="search" id="search-input" placeholder="Caută produse..." autocomplete="off" aria-label="Caută produse" />
      <div id="search-results" class="search-dropdown" hidden></div>
    </div>

    <button class="nav-toggle" id="nav-toggle" aria-label="Deschide meniu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script src="/search.js" defer></script>
