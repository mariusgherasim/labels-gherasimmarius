---
import { SITE } from '../lib/site';
export interface Props { size?: number; class?: string }
const { size = 36, class: cls = '' } = Astro.props;
---
<a href="/" class={`logo ${cls}`} aria-label={`${SITE.name} — acasă`}>
  <svg width={size} height={size} viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect width="40" height="40" rx="9" fill="#E63329"/>
    <path d="M8 19.5 20 9l12 10.5" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M12 18v13h16V18" stroke="#fff" stroke-width="3.2" stroke-linejoin="round"/>
    <rect x="17" y="22" width="6" height="9" rx="1" fill="#FFC629"/>
  </svg>
  <span class="logo-text">{SITE.wordmark[0]}<strong>{SITE.wordmark[1]}</strong></span>
</a>
