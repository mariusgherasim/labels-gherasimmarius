---
export interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}
const { currentPage, totalPages, baseUrl } = Astro.props;
const prev = currentPage > 1 ? (currentPage === 2 ? baseUrl : `${baseUrl}/${currentPage - 1}`) : null;
const next = currentPage < totalPages ? `${baseUrl}/${currentPage + 1}` : null;

const pages: (number | '...')[] = [];
for (let i = 1; i <= totalPages; i++) {
  if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
    pages.push(i);
  } else if (pages[pages.length - 1] !== '...') {
    pages.push('...');
  }
}
---
{totalPages > 1 && (
  <nav class="pagination" aria-label="Paginare">
    {prev
      ? <a href={prev} class="page-btn" aria-label="Pagina anterioară">← Anterior</a>
      : <span class="page-btn disabled">← Anterior</span>
    }
    <div class="page-numbers">
      {pages.map(p =>
        p === '...'
          ? <span class="page-ellipsis">…</span>
          : p === currentPage
            ? <span class="page-num active" aria-current="page">{p}</span>
            : <a href={p === 1 ? baseUrl : `${baseUrl}/${p}`} class="page-num">{p}</a>
      )}
    </div>
    {next
      ? <a href={next} class="page-btn" aria-label="Pagina următoare">Următor →</a>
      : <span class="page-btn disabled">Următor →</span>
    }
  </nav>
)}
