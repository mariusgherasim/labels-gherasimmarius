---
import { fmt } from '../lib/site';
export interface Props {
  title: string;
  price: number;
  old_price?: number | null;
  brand: string;
  image: string;
  url: string;
  category: string;
  merchant?: string;
  eager?: boolean;
  sizes?: number; // covoare: câte mărimi are modelul
}
const { title, price, old_price, brand, image, url, category, merchant = '', eager = false, sizes = 0 } = Astro.props;
const discount = old_price && old_price > price ? Math.round(100 - (price / old_price) * 100) : null;
---
<article class="product-card">
  {discount && <span class="badge-discount">-{discount}%</span>}
  <a href={url} target="_blank" rel="nofollow noopener sponsored" class="card-image-link aff" aria-label={title} data-name={title} data-cat={category}>
    <div class="card-image">
      <img src={image || '/placeholder.svg'} alt={title} loading={eager ? 'eager' : 'lazy'} decoding="async" onerror="this.onerror=null;this.src='/placeholder.svg'" />
    </div>
  </a>
  <div class="card-body">
    {brand && <span class="card-brand">{brand}</span>}
    <h3 class="card-title">
      <a href={url} target="_blank" rel="nofollow noopener sponsored" class="aff" data-name={title} data-cat={category}>{title}</a>
    </h3>
    <div class="card-price">
      <span class="price-current">{sizes > 1 && <small class="price-from">de la </small>}{fmt(price)} lei</span>
      {discount && <span class="price-old">{fmt(old_price as number)} lei</span>}
    </div>
    <a href={url} target="_blank" rel="nofollow noopener sponsored" class="btn-buy aff" data-name={title} data-cat={category}>
      Vezi oferta <span aria-hidden="true">→</span>
    </a>
    {(merchant || sizes > 1) && <span class="card-merchant">{sizes > 1 ? `${sizes} mărimi · ` : ''}{merchant && `la ${merchant}`}</span>}
  </div>
</article>
