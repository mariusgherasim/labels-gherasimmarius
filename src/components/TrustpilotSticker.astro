---
// Sticker Trustpilot (Review Collector) — casaatelier.website
// Desktop: caseta mica in stanga, la mijlocul ecranului. Mobil: bara fixa jos.
// X-ul il ascunde doar pe pagina curenta; la urmatoarea pagina reapare.
---
<div id="tp-sticker">
  <button type="button" class="tp-close" id="tp-close" title="Închide" aria-label="Închide">✕</button>
  <div class="tp-sticker-label">Recenzii clienți</div>
  <!-- TrustBox widget - Review Collector -->
  <div class="trustpilot-widget"
       data-locale="ro-RO"
       data-template-id="56278e9abfbbba0bdcd568bc"
       data-businessunit-id="6adb89974716e8a5ad9e4841"
       data-style-height="52px"
       data-style-width="100%">
    <a href="https://www.trustpilot.com/review/casaatelier.website" target="_blank" rel="noopener">Trustpilot</a>
  </div>
  <!-- End TrustBox widget -->
</div>

<style is:global>
  #tp-sticker {
    position: fixed; left: 12px; top: 50%; transform: translateY(-50%);
    z-index: 65; background: #fff; border-radius: 10px;
    box-shadow: 0 4px 20px rgba(0,0,0,.15); padding: 8px 12px 6px; min-width: 220px;
  }
  #tp-sticker[hidden] { display: none !important; }
  .tp-close {
    position: absolute; top: 5px; right: 5px; z-index: 1; width: 18px; height: 18px; padding: 0;
    background: rgba(0,0,0,.08); color: #555; border: none; border-radius: 50%; cursor: pointer;
    display: flex; align-items: center; justify-content: center; font-size: 10px; line-height: 1;
  }
  .tp-close:hover { background: rgba(0,0,0,.18); color: #111; }
  .tp-sticker-label { font-size: .62rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: #555; margin-bottom: 4px; font-family: Inter, system-ui, sans-serif; }
  /* Mobil: bara fixa jos; stickerele de oferte urca deasupra ei */
  @media (max-width: 640px) {
    #tp-sticker {
      top: auto; bottom: 0; left: 0; right: 0; transform: none; min-width: 0;
      border-radius: 12px 12px 0 0; padding: 6px 12px;
      display: flex; align-items: center; gap: 10px; box-shadow: 0 -4px 16px rgba(0,0,0,.12);
    }
    .tp-sticker-label { margin: 0; flex: 0 0 auto; max-width: 70px; line-height: 1.3; }
    #tp-sticker .trustpilot-widget { flex: 1; min-width: 0; margin-right: 18px; }
    .tp-close { top: 50%; right: 8px; transform: translateY(-50%); }
    .sticker-float { bottom: 72px !important; }
    body { padding-bottom: 68px; }
    html.tp-inchis .sticker-float { bottom: 10px !important; }
    html.tp-inchis body { padding-bottom: 0; }
  }
</style>
<script is:inline>
  (function () {
    var btn = document.getElementById('tp-close');
    if (!btn) return;
    btn.addEventListener('click', function (e) {
      e.preventDefault(); e.stopPropagation();
      var el = document.getElementById('tp-sticker');
      if (el) el.hidden = true;
      document.documentElement.classList.add('tp-inchis');
    });
  })();
</script>
