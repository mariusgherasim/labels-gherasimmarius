---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import Pagination from '../../components/Pagination.astro';
import allProducts from '../../data/products.json';

export function getStaticPaths() {
  const PER_PAGE = 24;
  const products = allProducts.filter(p => p.category === 'ambalare');
  const totalPages = Math.ceil(products.length / PER_PAGE);
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { pageNum: i + 2, products, totalPages, PER_PAGE },
  }));
}

const { pageNum, products, totalPages, PER_PAGE } = Astro.props;
const pageProducts = products.slice((pageNum - 1) * PER_PAGE, pageNum * PER_PAGE);
---
<Base title={`Ambalare & Coletare — Pagina ${pageNum} | LabelShop`} description={`Ambalare & Coletare — pagina ${pageNum} din ${totalPages}. Cutii carton clasice și e-commerce, plicuri AWB și cu bule, pungi curierat, folie stretch, bandă adezivă`}>
  <Header />
  <main>
    <section class="cat-hero">
      <div class="container">
        <h1>📦 Ambalare & Coletare — Cutii, Plicuri, Pungi, Folii</h1>
        <p>{products.length} produse — pagina {pageNum} din {totalPages}</p>
      </div>
    </section>
    <section class="section-products">
      <div class="container">
        <div class="products-grid">
          {pageProducts.map(p => <ProductCard title={p.title} price={p.price} old_price={p.old_price} brand={p.brand} image={p.image} url={p.url} category={p.category} />)}
        </div>
        <Pagination currentPage={pageNum} totalPages={totalPages} baseUrl="/ambalare" />
      </div>
    </section>
  </main>
  <Footer />
</Base>
