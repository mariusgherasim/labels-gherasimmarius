---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import { CATEGORIES, PRODUCTS, MERCHANTS, SITE, productsInCat, countCat, countSub, deals, diverse, discount, fmtInt, type Product } from '../lib/site';

const total = PRODUCTS.length;
const allDeals = deals();
const topDeals = diverse(allDeals, 12, 2);
const maxDisc = Math.max(...allDeals.map(discount));
const subCount = CATEGORIES.reduce((n, c) => n + c.subs.filter(s => countSub(c.slug, s.slug) > 0).length, 0);

// pentru fiecare categorie: 4 produse variate, întâi cele cu reducere
const pickFor = (slug: string): Product[] => {
  const list = productsInCat(slug);
  const disc = list.filter(p => discount(p) > 0);
  return diverse([...disc.slice(0, 40), ...list.slice(0, 80)], 4, 1).length >= 4
    ? diverse([...disc.slice(0, 40), ...list.slice(0, 80)], 4, 1)
    : diverse([...disc.slice(0, 40), ...list.slice(0, 80)], 4, 4);
};
---
<Base
  title={`${SITE.name} — mobilă, grădină, scule, securitate și birou | ${fmtInt(total)} produse`}
  description={`${SITE.description} ${fmtInt(allDeals.length)} produse la reducere acum.`}
>
  <Header />
  <main>
    <div class="promo-strip">
      <p>🔥 <strong>{fmtInt(allDeals.length)}</strong> produse la reducere acum, până la <strong>-{maxDisc}%</strong>. <a href="/promotii">Vezi promoțiile →</a></p>
    </div>

    <section class="hero">
      <div class="container hero-inner">
        <div class="hero-text">
          <p class="hero-eyebrow">Casă · Curte · Atelier · Birou</p>
          <h1>Tot ce-ți trebuie pentru <span class="hero-accent">casă, curte</span> și atelier</h1>
          <p class="hero-desc">
            De la canapele și paturi la drujbe, pompe de apă, camere de supraveghere și etichete pentru firmă —
            {fmtInt(total)} de produse adunate din {MERCHANTS.length} magazine românești, într-un singur loc, cu prețurile și reducerile lor reale.
          </p>
          <div class="hero-stats">
            <div class="stat"><strong>{fmtInt(total)}</strong><span>produse</span></div>
            <div class="stat"><strong>{MERCHANTS.length}</strong><span>magazine</span></div>
            <div class="stat"><strong>{subCount}</strong><span>tipuri de produse</span></div>
            <div class="stat"><strong>-{maxDisc}%</strong><span>reducere maximă</span></div>
          </div>
          <div class="hero-cta">
            <a href="/promotii" class="btn-primary">Vezi reducerile →</a>
            <button type="button" class="btn-secondary" data-open-search>Caută un produs</button>
          </div>
        </div>
        <div class="hero-cats">
          {CATEGORIES.map(c => (
            <a href={`/${c.slug}`} class="hero-cat" style={`--acc:${c.accent}`}>
              <span class="hero-cat-ico" aria-hidden="true">{c.icon}</span>
              <strong>{c.short}</strong>
              <em>{fmtInt(countCat(c.slug))}</em>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section-products">
      <div class="container">
        <div class="section-head">
          <h2>🔥 Cele mai bune reduceri azi</h2>
          <a href="/promotii" class="see-all">Toate promoțiile ({fmtInt(allDeals.length)}) →</a>
        </div>
        <div class="products-grid products-grid--6">
          {topDeals.map((p, i) => <ProductCard title={p.title} price={p.price} old_price={p.old_price} brand={p.brand} image={p.image} url={p.url} category={p.cat} merchant={p.merchant} sizes={p.sizes} eager={i < 4} />)}
        </div>
      </div>
    </section>

    {CATEGORIES.map((c, i) => (
      <section class={`section-products cat-block ${i % 2 === 0 ? 'section-alt' : ''}`} style={`--acc:${c.accent}`}>
        <div class="container">
          <div class="section-head">
            <h2><span aria-hidden="true">{c.icon}</span> {c.name}</h2>
            <a href={`/${c.slug}`} class="see-all">Toate ({fmtInt(countCat(c.slug))}) →</a>
          </div>
          <div class="cat-block-subs">
            {c.subs.filter(s => !s.hidden && countSub(c.slug, s.slug) > 0).map(s => (
              <a href={`/${c.slug}/${s.slug}`} class="sub-chip">{s.name}</a>
            ))}
          </div>
          <div class="products-grid products-grid--4">
            {pickFor(c.slug).map(p => <ProductCard title={p.title} price={p.price} old_price={p.old_price} brand={p.brand} image={p.image} url={p.url} category={p.cat} merchant={p.merchant} sizes={p.sizes} />)}
          </div>
        </div>
      </section>
    ))}

    <section class="usp-strip">
      <div class="container">
        <div class="usp-grid">
          <div class="usp-item"><span class="usp-icon">🏪</span><div class="usp-text"><strong>{MERCHANTS.length} magazine, o singură căutare</strong><p>Nu mai deschizi zece taburi ca să găsești o pompă sau un colțar.</p></div></div>
          <div class="usp-item"><span class="usp-icon">🏷️</span><div class="usp-text"><strong>Prețuri reale</strong><p>Prețurile și reducerile vin direct din feedurile magazinelor.</p></div></div>
          <div class="usp-item"><span class="usp-icon">🚚</span><div class="usp-text"><strong>Cumperi direct de la magazin</strong><p>Comanda, livrarea și garanția sunt ale magazinului partener.</p></div></div>
          <div class="usp-item"><span class="usp-icon">📬</span><div class="usp-text"><strong>Oferte pe categorii</strong><p>Abonează-te și primești reducerile care te interesează.</p></div></div>
        </div>
      </div>
    </section>

    <section class="section-products seo-block">
      <div class="container">
        <div class="seo-text">
          <h2>Mobilă, grădină, scule, securitate și etichete — într-un singur loc</h2>
          <p>{SITE.name} adună produse pentru casă, curte și atelier de la magazine românești specializate. Găsești <a href="/mobila-living/canapele-coltare">canapele și colțare extensibile</a>, <a href="/mobila-living/paturi-dormitor">paturi tapițate</a>, <a href="/mobila-living/mese">mese dining</a> și <a href="/mobila-living/scaune">scaune</a>, dar și tot ce trebuie pentru grădină: <a href="/gradina-agricultura/motocoase">motocoase</a>, <a href="/gradina-agricultura/drujbe">drujbe</a>, <a href="/gradina-agricultura/pompe-apa">pompe de apă</a> și <a href="/gradina-agricultura/irigatii">sisteme de irigare</a>.</p>
          <p>Pentru atelier și șantier ai <a href="/scule-utilaje/scule-electrice">scule electrice</a> Milwaukee, Hecht sau DeToolz, <a href="/scule-utilaje/utilaje-constructii">utilaje de construcții</a> și piese de schimb. Pentru siguranța casei: <a href="/securitate-smart-home/camere-supraveghere">camere de supraveghere</a> Hikvision și Dahua, <a href="/securitate-smart-home/alarme">sisteme de alarmă</a>, <a href="/securitate-smart-home/videointerfoane">videointerfoane</a> și <a href="/securitate-smart-home/automatizari-porti">automatizări pentru porți</a>.</p>
          <p>Firmele găsesc în continuare <a href="/birou-etichete-ambalare/etichete">etichete autoadezive</a>, <a href="/birou-etichete-ambalare/imprimante-etichete">imprimante termice</a>, <a href="/birou-etichete-ambalare/consumabile-etichetare">riboane</a>, <a href="/birou-etichete-ambalare/ambalare">ambalaje</a>, imprimante de birou și tonere.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
