---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import Pagination from '../../components/Pagination.astro';
import allProducts from '../../data/products.json';

const PER_PAGE = 24;
const products = allProducts
  .filter(p => p.old_price && p.old_price > p.price)
  .sort((a, b) => {
    const discA = Math.round(100 - (a.price / a.old_price) * 100);
    const discB = Math.round(100 - (b.price / b.old_price) * 100);
    return discB - discA; // cele mai mari reduceri primele
  });

const totalPages = Math.ceil(products.length / PER_PAGE);
const page = products.slice(0, PER_PAGE);

const maxDiscount = Math.max(...products.map(p => Math.round(100 - (p.price / p.old_price) * 100)));
const avgDiscount = Math.round(products.reduce((sum, p) => sum + Math.round(100 - (p.price / p.old_price) * 100), 0) / products.length);
---
<Base
  title={`Promoții etichete și ambalaje (${products.length} produse la reducere) | LabelShop`}
  description={`${products.length} produse la reducere: etichete autoadezive, imprimante termice, ambalaje. Reduceri până la ${maxDiscount}%. Oferte constante, nu doar de Black Friday.`}
>
  <Header />
  <main>
    <section class="cat-hero">
      <div class="container">
        <h1>🔥 Promoții & Oferte</h1>
        <p>{products.length} produse la reducere — până la {maxDiscount}% reducere · reducere medie {avgDiscount}%</p>
      </div>
    </section>

    <div class="promo-strip">
      <p>Oferte și promoții constante, nu doar de Black Friday! Toate prețurile afișate sunt prețurile reale de vânzare.</p>
    </div>

    <section class="section-products">
      <div class="container">
        <div class="products-grid">
          {page.map(p => (
            <ProductCard
              title={p.title}
              price={p.price}
              old_price={p.old_price}
              brand={p.brand}
              image={p.image}
              url={p.url}
              category={p.category}
            />
          ))}
        </div>
        <Pagination currentPage={1} totalPages={totalPages} baseUrl="/promotii" />
      </div>
    </section>
  </main>
  <Footer />
</Base>
